<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.poo.controlador.HistorialControlador" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Buscar Mascota:" />
            <TextField fx:id="txtBuscarMascota" prefHeight="25.0" prefWidth="300.0" promptText="Ingrese el nombre de la mascota..." />
            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarHistorialAccion" text="Buscar Historial" />
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarBusquedaAccion" text="Limpiar" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="5.0" />
         </padding>
         <children>
            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Historial de Turnos y Servicios" />
            <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colFecha" prefWidth="90.0" text="Fecha" />
                <TableColumn fx:id="colHora" prefWidth="70.0" text="Hora" />
                <TableColumn fx:id="colMascota" prefWidth="120.0" text="Mascota" />
                <TableColumn fx:id="colVeterinario" prefWidth="150.0" text="Veterinario" />
                <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                <TableColumn fx:id="colServicios" prefWidth="320.0" text="Servicios Realizados" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>